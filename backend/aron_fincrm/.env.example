# OpenAI-compatible API endpoint; keep the real API key in .env and out of source control.
AI_ASSISTANT_API_URL=https://api.groq.com/openai/v1/chat/completions
AI_ASSISTANT_API_KEY=replace_with_your_api_key
AI_ASSISTANT_MODEL=openai/gpt-oss-120b
AI_ASSISTANT_TIMEOUT=30

# Razorpay test credentials. Keep the key secret on the backend only.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_secret
RAZORPAY_WEBHOOK_SECRET=your_test_webhook_secret

# Gmail SMTP settings for registration links and enterprise inquiries.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=yourcrm@gmail.com
EMAIL_HOST_PASSWORD=your_16_character_app_password
DEFAULT_FROM_EMAIL=yourcrm@gmail.com
ENTERPRISE_INQUIRY_ADMIN_EMAIL=yourcrm@gmail.com

# SQLite remains the default. Opt into PostgreSQL only after provisioning the
# database and rehearsing the data migration on a protected copy.
# DB_ENGINE=postgresql
# DB_NAME=fincrm
# DB_USER=fincrm_app
# DB_PASSWORD=replace_in_secret_manager
# DB_HOST=postgres.internal
# DB_PORT=5432
# DB_SSLMODE=require
# DB_SSLROOTCERT=
# DB_CONN_MAX_AGE=60

# Keep plan checkout disabled until the business prices are confirmed and
# written to the plan catalog. This flag does not change prices by itself.
SUBSCRIPTION_CHECKOUT_ENABLED=false

# Public frontend origin used in emailed one-time registration links.
FRONTEND_URL=http://localhost:5173
